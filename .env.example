# ============================================================================
# Venture OS Lite — environment. Copy to .env and fill in. NEVER commit .env.
# ============================================================================

# ---- Database (DB_FLAVOR decides; postgres recommended) --------------------
DB_FLAVOR=postgres
# Local dev connects to the Dockerized DB on localhost.
DATABASE_URL=postgresql://venture:venture@localhost:5432/ventureos?schema=public
# For MySQL instead:
#   DB_FLAVOR=mysql
#   DATABASE_URL=mysql://venture:venture@localhost:3306/ventureos

# ---- Jobs / cache ----------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ---- Auth (Auth.js / NextAuth) ---------------------------------------------
NEXTAUTH_SECRET=change-me-generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# ---- Anthropic (server-side only; never exposed to the client) -------------
ANTHROPIC_API_KEY=

# ---- Prospecting & auditing ------------------------------------------------
GOOGLE_PLACES_API_KEY=
PAGESPEED_API_KEY=

# ---- Email (Mailgun EU) ----------------------------------------------------
MAILGUN_API_KEY=
MAILGUN_DOMAIN=mail.ventureco.group
MAILGUN_EU=true
# Mailgun webhook (delivery/open/bounce) HMAC signing key.
MAILGUN_WEBHOOK_SIGNING_KEY=
# mailgun | mock  (defaults: mailgun when MAILGUN_API_KEY is set, else mock)
MAIL_PROVIDER=mock

# ---- Meetings: Google Calendar OAuth (§4.8) --------------------------------
# google | mock  (defaults: google when GOOGLE_CLIENT_ID is set, else mock)
CALENDAR_PROVIDER=mock
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

# ---- Company registry enrichment (§4.19) -----------------------------------
# mock | opten  (defaults to mock for dev)
REGISTRY_PROVIDER=mock
REGISTRY_API_KEY=

# ---- Számlázz.hu Számla Agent (§4.23) --------------------------------------
# mock | szamlazz  (defaults to mock; per-workspace agent key stored in Settings)
SZAMLAZZ_PROVIDER=mock

# ---- App -------------------------------------------------------------------
APP_URL=http://localhost:3000
FILES_DIR=/data/files

# ============================================================================
# Docker Compose helpers (not app secrets — used by docker-compose.yml).
# ============================================================================
# Which db service `docker compose up` (no service args) starts. Match DB_FLAVOR.
COMPOSE_PROFILES=postgres

# Domain Caddy serves + gets an automatic HTTPS cert for. `localhost` in dev.
APP_DOMAIN=localhost

# DATABASE_URL used *inside* the app/worker containers (in-network host names).
APP_DATABASE_URL=postgresql://venture:venture@db:5432/ventureos?schema=public
# MySQL: APP_DATABASE_URL=mysql://venture:venture@db-mysql:3306/ventureos

# Postgres service credentials
POSTGRES_USER=venture
POSTGRES_PASSWORD=venture
POSTGRES_DB=ventureos

# MySQL service credentials (only when DB_FLAVOR=mysql)
MYSQL_DATABASE=ventureos
MYSQL_USER=venture
MYSQL_PASSWORD=venture
MYSQL_ROOT_PASSWORD=venture
