# =============================================================================
# Venture OS Lite — worker image (BullMQ jobs + Playwright).
#
# Playwright's image ships a matching Node and a headless Chromium that is
# already installed and patched, which is what the website auditor and the PDF
# pipeline (audits, quotes, contracts, certificates, briefs) both drive.
#
# This image also serves as the one-shot `migrate` service: it carries the full
# dependency tree, so the Prisma CLI and tsx are available for
# `prisma migrate deploy` and `scripts/apply-rls.ts`.
# =============================================================================
# The tag MUST track the `playwright` version in package-lock.json. The image
# ships pre-installed browser builds keyed to its own release, so a mismatch
# fails at runtime with "Executable doesn't exist at /ms-playwright/..." —
# invisible locally, where browsers live on the host.
FROM mcr.microsoft.com/playwright:v1.62.1-jammy

WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
# NOTE: no SKIP_ENV_VALIDATION here — the worker must run its own boot gate
# (src/worker/index.ts) and die on a bad configuration.

# procps provides pgrep for the healthcheck below.
RUN apt-get update && apt-get install -y --no-install-recommends procps \
  && rm -rf /var/lib/apt/lists/*

# Install with dev dependencies present: the Prisma CLI and tsx are devDeps and
# are required both to migrate and to run the TypeScript worker entrypoint.
#
# --include=dev is NOT redundant. NODE_ENV=production is set above (the runtime
# needs it), and npm honours that during install by omitting devDependencies —
# which silently dropped tsx and left `npm run worker` dying with
# "sh: 1: tsx: not found" in a restart loop, while the app container stayed
# healthy and made the stack look fine.
COPY package.json package-lock.json* ./
RUN npm ci --include=dev && npm cache clean --force

# Self-heal any residual drift between the package and the image's browsers:
# a no-op when the versions match, a download when they do not, so the image
# can never ship without the Chromium the installed Playwright expects.
RUN npx playwright install chromium

COPY . .
RUN npx prisma generate

# Shared file volume, same path as the app.
RUN mkdir -p /data/files

# `pgrep node` is enough: the worker has no HTTP surface, so liveness means the
# process is up and BullMQ has not crashed the event loop.
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
  CMD pgrep -f "src/worker/index.ts" > /dev/null || exit 1

CMD ["npm", "run", "worker"]
