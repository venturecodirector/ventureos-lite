{
  "manifest_version": 3,
  "name": "Venture OS — Capture",
  "version": "2.5.0",
  "description": "Capture the LinkedIn profile you are viewing into Venture OS. Reads a page when you ask it to \u2014 from the popup, or when Venture OS requests one. Never posts, messages or acts for you.",
  "minimum_chrome_version": "116",

  "permissions": ["activeTab", "scripting", "storage", "clipboardWrite"],

  "optional_host_permissions": ["https://*/*"],

  "action": {
    "default_popup": "popup.html",
    "default_title": "Capture into Venture OS",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },

  "background": { "service_worker": "background.js" },

  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
