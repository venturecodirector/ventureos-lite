// Venture OS Lite — Prisma schema (spec §8: v1.0 + v1.1 entities).
//
// PORTABILITY (CLAUDE.md): the schema runs on Postgres 16 and MySQL 8. To stay
// portable we avoid Postgres-only column types:
//   - no scalar lists (String[]) — MySQL can't do them; array-ish data is Json
//   - long free text is @db.Text (valid native type on both connectors)
//   - USD amounts are Decimal, HUF is integer forints (Int), never floats
// Switch `provider` to "mysql" when DB_FLAVOR=mysql (and point DATABASE_URL at
// MySQL). Columns/tables are snake_cased via @map so the RLS SQL lines up.
//
// TENANCY (CLAUDE.md hard rule #1): every business table carries workspace_id
// and is scoped by the mandatory tenant guard (src/lib/tenant-guard.ts). On
// Postgres, RLS policies keyed to membership add DB-level enforcement.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // set to "mysql" when DB_FLAVOR=mysql
  url      = env("DATABASE_URL")
}

// ============================================================================
// Enums (portable across postgres + mysql)
// ============================================================================

enum Role {
  OWNER
  ADMIN
  BDR
}

enum LeadSource {
  PROSPECTOR
  LINKEDIN
  MANUAL
  REFERRAL
  COLD_EMAIL
  /// Came to us: ran their own audit on the public landing and asked for the
  /// report (P12/1c). The warmest source there is, and the only one where the
  /// lawful basis for contacting them is a consent record.
  SELF_SERVE_AUDIT
}

enum Stage {
  RESEARCHED
  CONTACTED
  ACCEPTED
  REPLIED
  QUALIFIED
  MEETING_BOOKED
  HANDED_OFF
  NOT_NOW
  DISQUALIFIED
}

enum Lang {
  HU
  EN
}

enum TemplateType {
  QUOTE
  CONTRACT
  CERTIFICATE
  EMAIL
}

enum TemplateStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum DocumentType {
  QUOTE
  CONTRACT
  CERTIFICATE
}

enum DocumentStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
  SIGNED
  ACKNOWLEDGED
}

enum EmailStatus {
  QUEUED
  DELIVERED
  OPENED
  BOUNCED
  FAILED
}

enum CallOutcome {
  NO_ANSWER
  CALLBACK_REQUESTED
  INTERESTED
  NOT_INTERESTED
  WRONG_NUMBER
}

enum CampaignStatus {
  DRAFT
  PAUSED
  ACTIVE
  COMPLETED
  DISABLED
}

enum ReferrerKind {
  PERSON
  COMPANY
}

enum DealResult {
  WON
  LOST
  POSTPONED
}

enum InvoiceStatus {
  PREPARED
  SUBMITTED
  ISSUED
  PAID
  FAILED
}

enum AuditVerdict {
  STRONG
  POSSIBLE
  SKIP
}

enum MessageDirection {
  OUTBOUND
  INBOUND
}

enum MessageChannel {
  LINKEDIN
  EMAIL
  COLD_EMAIL
}

enum MessageStatus {
  DRAFT
  SENT
  FAILED
}

enum FrameStatus {
  DRAFT
  PROPOSED
  APPROVED
  ARCHIVED
}

enum InsightKind {
  DAILY
  WEEKLY
}

// ============================================================================
// Global (NOT tenant-scoped): identity + tenancy mapping. No workspace_id.
// These are excluded from the tenant guard; RLS restricts them to the acting
// user / their memberships.
// ============================================================================

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  name                String
  passwordHash        String               @map("password_hash")
  totpSecret          String?              @map("totp_secret") // base32, set at enrollment
  totpEnabled         Boolean              @default(false) @map("totp_enabled")
  /// Consumed TOTP step, so a code cannot be replayed inside its 30s window.
  totpLastStep        Int?                 @map("totp_last_step")
  lockedUntil         DateTime?            @map("locked_until")
  lastLoginAt         DateTime?            @map("last_login_at")
  /// Forces a password change on next login (seeded/reset accounts).
  mustChangePassword  Boolean              @default(false) @map("must_change_password")
  /// Set when an Owner resets someone's 2FA: the old secret is gone and they
  /// must scan a fresh QR before they can use the app again.
  mustEnrollTotp      Boolean              @default(false) @map("must_enroll_totp")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  memberships         Membership[]
  sessions            Session[]
  googleCredentials   GoogleCredential[]
  captureTokens       CaptureToken[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

// Global (per-user) Google OAuth tokens for Calendar (spec §4.8). Not tenant-scoped.
/// One connected Google account. A host may connect several — typically a
/// business account that meetings are written to, plus a personal one that
/// only contributes busy times so nobody books over a dentist appointment.
model GoogleCredential {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  /// Which Google account this is, for the UI and to keep reconnects idempotent.
  accountEmail String?   @map("account_email")
  /// WRITE = meetings are created here (exactly one per host).
  /// BUSY_ONLY = read for availability, never written to.
  purpose      String    @default("WRITE")
  accessToken  String    @map("access_token")
  refreshToken String?   @map("refresh_token")
  expiryDate   DateTime? @map("expiry_date")
  scope        String?
  calendarId   String?   @map("calendar_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Reconnecting the same Google account updates it rather than duplicating.
  @@unique([userId, accountEmail])
  @@index([userId])
  @@map("google_credentials")
}

/// Server-side session (CLAUDE.md → Auth). The browser cookie only carries an
/// opaque token; the row here is authoritative, so a session can be revoked
/// server-side and survives no client state. `token` stores a SHA-256 hash —
/// a database leak must not hand out usable sessions.
model Session {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  token       String    @unique // sha256(opaque token), never the token itself
  workspaceId String?   @map("workspace_id") // active workspace for this session
  ip          String?
  userAgent   String?   @map("user_agent")
  expiresAt   DateTime  @map("expires_at")
  lastSeenAt  DateTime  @default(now()) @map("last_seen_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// One-time password-reset link issued by an Owner. Only a SHA-256 hash is
/// stored, so a database leak yields no usable links; single-use and short-lived.
model PasswordResetToken {
  id              String    @id @default(cuid())
  userId          String    @map("user_id")
  token           String    @unique // sha256(raw token)
  expiresAt       DateTime  @map("expires_at")
  usedAt          DateTime? @map("used_at")
  createdByUserId String?   @map("created_by_user_id")
  createdAt       DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

/// Login attempt ledger, used for rate limiting and lockout (CLAUDE.md → Auth:
/// "rate-limited login"). Keyed by email AND by IP so neither a single account
/// nor a single source can be hammered. Pruned by the retention sweep.
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String?
  ok        Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email, createdAt])
  @@index([ip, createdAt])
  @@map("login_attempts")
}

model Membership {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  workspaceId String    @map("workspace_id")
  role        Role      @default(BDR)
  grants      Json      @default("[]") // string[] of capability grants (portable as Json)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
  @@map("memberships")
}

model Workspace {
  id            String       @id @default(cuid())
  name          String
  legalName     String?      @map("legal_name")
  brand         Json?        @map("brand_json")
  mailgunConfig Json?        @map("mailgun_config")
  icpConfig     Json?        @map("icp_config")
  auditConfig   Json?        @map("audit_config") // verdict thresholds + check weights
  claudeBudget  Decimal      @default(2) @map("claude_budget") // USD daily cap
  retentionDays Int          @default(365) @map("retention_days")
  featureFlags  Json?        @map("feature_flags")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  memberships   Membership[]

  @@map("workspaces")
}

// ============================================================================
// Business (tenant-scoped): every table has workspace_id + an index on it.
// ============================================================================

model Company {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  name        String
  domain      String?
  website     String?
  industry    String?
  sizeBand    String?  @map("size_band")
  phone       String?
  address     String?
  city        String?
  taxId       String?  @map("tax_id") // adószám — dedupe key within a workspace
  /// How this company entered the workspace, when it was not a prospect we
  /// chose: "competitor_audit" for one pulled in by a comparison (P2/3). Null
  /// for everything created the ordinary way.
  source      String?
  notes       String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  leads     Lead[]
  audits    AuditResult[]
  auditWatch AuditWatch?
  keywords   TrackedKeyword[]
  logUploads LogUpload[]
  registry  RegistryData?
  referrers Referrer[]

  @@unique([workspaceId, taxId])
  @@index([workspaceId])
  @@map("companies")
  /// Homepage prose, fetched once and cached for 30 days (P1/1c). Feeds the
  /// research prompt so Claude has the company's own words rather than three
  /// fields. Null when the site is unreachable or robots.txt forbids it.
  siteText      String?   @map("site_text") @db.Text
  /// When the fetch was last ATTEMPTED — set even on failure, so a dead site
  /// is not re-fetched on every research run.
  siteFetchedAt DateTime? @map("site_fetched_at")
}

model Lead {
  id             String     @id @default(cuid())
  workspaceId    String     @map("workspace_id")
  companyId      String?    @map("company_id")
  referrerId     String?    @map("referrer_id")
  contactName    String?    @map("contact_name")
  title          String?
  email          String?
  phone          String?
  linkedinUrl    String?    @map("linkedin_url")
  source         LeadSource @default(MANUAL)
  /// Language to write to this contact in. Feeds the outreach drafter, which
  /// previously always assumed Hungarian.
  language       Lang       @default(HU)
  stage          Stage      @default(RESEARCHED)
  stageEnteredAt DateTime   @default(now()) @map("stage_entered_at")
  stageReason    String?    @map("stage_reason")
  icpScore       Int?       @map("icp_score")
  scoreBreakdown Json?      @map("score_breakdown")
  signals        Json       @default("[]") // string[] of trigger signals
  qualification  Json? // { authority, history, budget, timeline } booleans
  escalatedAt    DateTime?  @map("escalated_at")
  notes          String?    @db.Text
  wakeUpAt       DateTime?  @map("wake_up_at")
  lastActivityAt DateTime?  @map("last_activity_at")
  anonymizedAt   DateTime?  @map("anonymized_at")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  company    Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  referrer   Referrer?     @relation(fields: [referrerId], references: [id], onDelete: SetNull)
  activities Activity[]
  messages   Message[]
  calls      Call[]
  meetings   Meeting[]
  documents  Document[]
  emailLogs  EmailLog[]
  outcomes   DealOutcome[]

  @@index([workspaceId])
  @@index([companyId])
  @@map("leads")
  /// Captured from the page the user was viewing (P1/1e). Personal data:
  /// all three join the erasure cascade and the anonymization job.
  avatarPath    String?   @map("avatar_path")
  bio           String?   @db.Text
  personBrief   String?   @map("person_brief") @db.Text
  briefAt       DateTime? @map("brief_at")
}

model Activity {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  leadId      String   @map("lead_id")
  type        String
  payload     Json?
  byUserId    String?  @map("by_user_id")
  at          DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([leadId])
  @@map("activities")
}

model Message {
  id          String           @id @default(cuid())
  workspaceId String           @map("workspace_id")
  leadId      String           @map("lead_id")
  direction   MessageDirection
  channel     MessageChannel   @default(LINKEDIN)
  kind        String? // connection | fu1 | fu2 | reply ...
  body        String           @db.Text
  aiDrafted   Boolean          @default(false) @map("ai_drafted")
  /// The EXACT text Claude produced. Kept alongside `body` so "was this really
  /// edited by a human?" is answered by comparison, not by trusting a flag the
  /// client could set (CLAUDE.md hard rule #6).
  aiDraftBody String?          @map("ai_draft_body") @db.Text
  humanEdited Boolean          @default(false) @map("human_edited")
  /// Claude's critique of the current draft (spec §4.6), shown beside it.
  critique    String?          @db.Text
  analysis    Json? // Haiku reply analysis (intent, objection, suggestions)
  status      MessageStatus    @default(DRAFT)
  sentAt      DateTime?        @map("sent_at")
  createdAt   DateTime         @default(now()) @map("created_at")

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([leadId])
  @@map("messages")
}

model Frame {
  id          String      @id @default(cuid())
  workspaceId String      @map("workspace_id")
  name        String
  body        String      @db.Text
  segment     String?
  version     Int         @default(1)
  status      FrameStatus @default(DRAFT)
  metrics     Json?
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  campaigns Campaign[]

  @@index([workspaceId])
  @@map("frames")
}

model Meeting {
  id            String   @id @default(cuid())
  workspaceId   String   @map("workspace_id")
  leadId        String?  @map("lead_id")
  hostUserId    String?  @map("host_user_id")
  scheduledAt   DateTime @map("scheduled_at")
  durationMin   Int      @default(30) @map("duration_min")
  type          String?
  googleEventId String?  @map("google_event_id")
  eventUrl      String?  @map("event_url")
  brief         String?  @db.Text
  briefStatus   String   @default("none") @map("brief_status")
  briefPdfPath  String?  @map("brief_pdf_path")
  outcome       String?
  createdAt     DateTime @default(now()) @map("created_at")

  lead Lead? @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([leadId])
  @@map("meetings")
}

model Insight {
  id          String      @id @default(cuid())
  workspaceId String      @map("workspace_id")
  kind        InsightKind
  body        String      @db.Text
  data        Json?
  createdAt   DateTime    @default(now()) @map("created_at")

  @@index([workspaceId])
  @@map("insights")
}

// Signal Engine approval queue (spec §4.13). The weekly job writes PENDING
// proposals; nothing self-modifies. An Owner approve applies the effect
// (versions a frame / updates a score weight); reject discards.
model Proposal {
  id              String         @id @default(cuid())
  workspaceId     String         @map("workspace_id")
  kind            ProposalKind
  title           String
  evidence        String         @db.Text
  n               Int
  data            Json
  status          ProposalStatus @default(PENDING)
  createdAt       DateTime       @default(now()) @map("created_at")
  decidedAt       DateTime?      @map("decided_at")
  decidedByUserId String?        @map("decided_by_user_id")

  @@index([workspaceId])
  @@map("proposals")
}

// Weekly analytics report (spec §4.14). Deterministic numbers in `data`; the
// Haiku "what worked" commentary and Fanni's comment are optional overlays.
model Report {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  weekLabel   String   @map("week_label")
  data        Json
  commentary  String?  @db.Text
  comment     String?  @db.Text
  pdfPath     String?  @map("pdf_path")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([workspaceId])
  @@map("reports")
}

enum ProposalKind {
  FRAME_PROMOTION
  SCORE_WEIGHT
}

enum ProposalStatus {
  PENDING
  APPROVED
  REJECTED
}

model Target {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  metric      String
  period      String // weekly | monthly | q30 | q60 | q90
  value       Int
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([workspaceId, metric, period])
  @@index([workspaceId])
  @@map("targets")
}

enum ContentStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  PUBLISHED
}

/// Company-page posts (spec §4.12). Drafted with Claude against a locked brand
/// voice, moved Draft → In review → Approved → Published by hand. Publishing
/// records that a human posted it; the system never posts anywhere itself
/// (CLAUDE.md hard rule #2).
model ContentPost {
  id           String        @id @default(cuid())
  workspaceId  String        @map("workspace_id")
  title        String
  body         String        @db.Text
  /// Where it is meant to go — linkedin | blog | newsletter.
  channel      String        @default("linkedin")
  status       ContentStatus @default(DRAFT)
  /// True when Claude produced the first version of this text.
  aiDrafted    Boolean       @default(false) @map("ai_drafted")
  /// Exactly what Claude produced, so "did a human edit it?" is answered by
  /// comparison rather than by a flag (same reasoning as outreach messages).
  aiDraftBody  String?       @map("ai_draft_body") @db.Text
  authorUserId String?       @map("author_user_id")
  approvedBy   String?       @map("approved_by")
  approvedAt   DateTime?     @map("approved_at")
  publishedAt  DateTime?     @map("published_at")
  /// Where it was posted, filled in by the person who published it.
  publishedUrl String?       @map("published_url")
  reviewNote   String?       @map("review_note") @db.Text
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@index([workspaceId, status])
  @@map("content_posts")
}

/// Per-workspace integration credentials (spec §4.24). Secrets are stored
/// AES-256-GCM encrypted (see src/lib/crypto.ts); non-secret values such as a
/// sending domain are stored in clear so they can be validated and displayed.
/// Infrastructure settings are deliberately NOT here — they stay in env.
model Integration {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  /// Registry key, e.g. "mailgun.cold.apiKey".
  key         String
  /// Encrypted payload for secret fields; null for plain ones.
  valueEnc    String?  @map("value_enc") @db.Text
  /// Clear value for non-secret fields; null for secrets.
  valuePlain  String?  @map("value_plain")
  updatedBy   String?  @map("updated_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([workspaceId, key])
  @@index([workspaceId])
  @@map("integrations")
}

model AuditLog {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  actorUserId String?  @map("actor_user_id")
  action      String
  entityType  String?  @map("entity_type")
  entityId    String?  @map("entity_id")
  meta        Json?
  at          DateTime @default(now())

  @@index([workspaceId])
  @@map("audit_logs")
}

model ProspectSearch {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  keywords    String
  location    String
  radius      String?
  cost        Decimal  @default(0) // USD spent on Places API
  results     Json?    @map("results_json")
  ranAt       DateTime @default(now()) @map("ran_at")
  expiresAt   DateTime @map("expires_at")

  @@index([workspaceId])
  @@map("prospect_searches")
}

model AuditResult {
  id           String       @id @default(cuid())
  workspaceId  String       @map("workspace_id")
  companyId    String?      @map("company_id")
  url          String
  status       String       @default("queued") // queued | running | done | error
  score        Int          @default(0)
  verdict      AuditVerdict @default(SKIP)
  checks       Json?        @map("checks_json")
  flags        Json         @default("[]")
  pitchSummary String?      @map("pitch_summary") @db.Text
  screenshots  Json         @default("[]")
  /// Multi-page crawl result (P2/1). Null on single-page audits — every
  /// public and self-serve run, and any internal run with the toggle off.
  crawl        Json?        @map("crawl_json")
  /// Chrome UX Report field data (P2/2). Null when the origin has too little
  /// traffic for Google to report on — the common case for a micro-SMB site.
  crux         Json?        @map("crux_json")
  /// Competitor side-by-side (P2/3): the audit ids this one is compared with.
  /// Lives on the prospect's audit because the same competitor audit is reused
  /// across several comparisons — a parent pointer on the competitor would be
  /// wrong the second time it is cited.
  comparison   Json?        @map("comparison_json")
  /// What changed since the previous audit of the same URL (P2/5). Null on a
  /// first run — there is nothing to compare against, which is not a delta of
  /// zero.
  delta        Json?        @map("delta_json")
  pdfPath      String?      @map("pdf_path")
  createdAt    DateTime     @default(now()) @map("created_at")
  expiresAt    DateTime     @map("expires_at")

  company      Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  shares       AuditShare[]
  publicAudits PublicAudit[]

  @@index([workspaceId])
  @@index([companyId])
  @@map("audit_results")
  /// Which check set and category mapping this audit was scored under.
  /// Reports render a cached audit with ITS version, so an older run keeps the
  /// grouping it was actually scored with instead of being reinterpreted.
  schemaVersion Int      @default(1) @map("schema_version")
}

/// A self-serve audit requested from the public landing page, before any
/// person is known. Anonymous by construction: we hold the URL, the coarse
/// client fingerprint needed for abuse control, and a pointer to the audit.
/// A Lead only appears later, if the visitor submits the report form (P12/1b).
/// A company whose website we re-audit on a schedule (P2/5).
///
/// Watching a prospect is how a second audit ever happens: the first one is a
/// snapshot, and only the comparison produces a reason to call. One row per
/// company, so enabling a watch twice is an update rather than a duplicate.
model AuditWatch {
  id            String    @id @default(cuid())
  workspaceId   String    @map("workspace_id")
  companyId     String    @map("company_id")
  /// The URL actually audited — a company's website field can change under us.
  url           String
  /// 30 | 90 | 180. Anything else is refused at the API layer.
  frequencyDays Int       @map("frequency_days")
  enabled       Boolean   @default(true)
  nextRunAt     DateTime  @map("next_run_at")
  lastRunAt     DateTime? @map("last_run_at")
  /// Who or what turned it on, for the audit trail.
  createdBy     String?   @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId])
  @@index([workspaceId])
  @@index([nextRunAt])
  @@map("audit_watches")
}

/// An uploaded access log and the aggregate we keep from it (P2/8).
///
/// GDPR: log lines contain IP addresses, which are personal data. The raw file
/// is processed, aggregated, and DELETED within 7 days — `rawPath` goes null
/// when that happens, and only `analysis` survives. Nothing here ever stores a
/// single line.
model LogUpload {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  companyId   String?   @map("company_id")
  filename    String
  bytes       Int
  /// queued | running | done | error
  status      String    @default("queued")
  error       String?   @db.Text
  /// Relative path under FILES_DIR while the raw file still exists.
  rawPath     String?   @map("raw_path")
  /// When the raw upload must be gone by.
  purgeAfter  DateTime  @map("purge_after")
  purgedAt    DateTime? @map("purged_at")
  analysis    Json?
  uploadedBy  String?   @map("uploaded_by")
  createdAt   DateTime  @default(now()) @map("created_at")

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([purgeAfter])
  @@map("log_uploads")
}

/// A thing someone has to do (playbook-v2 P3/3).
///
/// POLYMORPHIC LINK by design: a task hangs off a lead today, a deal once P4
/// exists, a document, or nothing at all. entityType + entityId rather than four
/// nullable foreign keys, because the alternative is a schema change every time
/// a new thing becomes taskable.
///
/// The cost of that choice is no cascade: erasing a lead does not delete its
/// tasks automatically, so eraseLeadData removes them explicitly. That is
/// written down here because it is exactly the kind of thing a future migration
/// forgets.
model Task {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  /// call | email | todo | follow_up
  type        String    @default("todo")
  title       String
  note        String?   @db.Text
  dueAt       DateTime? @map("due_at")
  /// lead | company | document | none
  entityType  String?   @map("entity_type")
  entityId    String?   @map("entity_id")
  /// Who owes this. Null means unassigned, which is visible rather than hidden.
  assigneeId  String?   @map("assignee_id")
  doneAt      DateTime? @map("done_at")
  /// Set when the system created it from a signal, so the UI can say why this
  /// task exists — and so a person's own tasks are distinguishable from ours.
  source      String?
  createdBy   String?   @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([workspaceId, doneAt, dueAt])
  @@index([workspaceId, entityType, entityId])
  @@index([assigneeId, doneAt])
  @@map("tasks")
}

// ============================================================================
// Email sync (playbook-v2 P2). Correspondence lives in a personal mailbox; the
// CRM only ever saw what someone pasted in. These tables hold the SUBSET that
// matches a known lead or company — never the mailbox at large.
// ============================================================================

/// One connected mailbox, and the state of syncing it.
///
/// Health is a stored field rather than something inferred at render time, so
/// Settings can say "reconnect needed" without probing Google on page load —
/// and so a token that expired at 3am is visible before someone wonders why the
/// timeline went quiet.
model MailAccount {
  id           String    @id @default(cuid())
  workspaceId  String    @map("workspace_id")
  userId       String    @map("user_id")
  /// gmail — the only provider today. IMAP arrives behind the same interface.
  provider     String    @default("gmail")
  /// Which mailbox this is, for the UI and to keep reconnects idempotent.
  accountEmail String    @map("account_email")
  /// The GoogleCredential carrying the mail scopes (purpose = "MAIL").
  credentialId String?   @map("credential_id")
  /// The `after:` boundary the next incremental pass starts from.
  watermark    DateTime?
  /// How far the 90-day backfill has walked back, so it can resume.
  backfillCursor DateTime? @map("backfill_cursor")
  backfillDone Boolean   @default(false) @map("backfill_done")
  /// ok | reconnect_needed | rate_limited | error
  health       String    @default("ok")
  lastError    String?   @db.Text @map("last_error")
  lastSyncAt   DateTime? @map("last_sync_at")
  enabled      Boolean   @default(true)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  threads EmailThread[]

  @@unique([userId, accountEmail])
  @@index([workspaceId])
  @@map("mail_accounts")
}

/// A conversation, matched to a lead or company.
model EmailThread {
  id              String   @id @default(cuid())
  workspaceId     String   @map("workspace_id")
  accountId       String   @map("account_id")
  /// Gmail's thread id, so a reply threads correctly for the recipient.
  providerThreadId String  @map("provider_thread_id")
  subject         String?  @db.Text
  leadId          String?  @map("lead_id")
  companyId       String?  @map("company_id")
  /// address | domain | manual. Recording HOW it matched is what lets a
  /// domain guess be corrected without the next sync re-matching it the same
  /// wrong way.
  matchType       String   @default("address") @map("match_type")
  lastMessageAt   DateTime @map("last_message_at")
  messageCount    Int      @default(0) @map("message_count")
  unread          Boolean  @default(false)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  account  MailAccount    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  messages EmailMessage[]

  @@unique([accountId, providerThreadId])
  @@index([workspaceId, lastMessageAt])
  @@index([leadId])
  @@map("email_threads")
}

/// One message. Attachment BYTES are fetched on demand; only metadata lives
/// here, so a synced mailbox does not become a second copy of every PDF a
/// client ever sent.
model EmailMessage {
  id                String   @id @default(cuid())
  workspaceId       String   @map("workspace_id")
  threadId          String   @map("thread_id")
  providerMessageId String   @map("provider_message_id")
  /// INBOUND | OUTBOUND, from the mailbox owner's point of view.
  direction         String
  fromAddress       String   @map("from_address")
  fromName          String?  @map("from_name")
  /// JSON arrays of addresses.
  toAddresses       Json     @map("to_addresses")
  ccAddresses       Json?    @map("cc_addresses")
  subject           String?  @db.Text
  snippet           String?  @db.Text
  /// Sanitized on ingest AND rendered in a sandboxed iframe. Email HTML is
  /// hostile input from strangers; one layer is not enough.
  bodyHtml          String?  @db.Text @map("body_html")
  bodyText          String?  @db.Text @map("body_text")
  hasAttachments    Boolean  @default(false) @map("has_attachments")
  /// [{ filename, mimeType, sizeBytes, providerAttachmentId, storedPath? }]
  attachments       Json?
  sentAt            DateTime @map("sent_at")
  /// When the Haiku reply analysis ran, if it ever did. Never set by backfill.
  analyzedAt        DateTime? @map("analyzed_at")
  createdAt         DateTime @default(now()) @map("created_at")

  thread EmailThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([threadId, providerMessageId])
  @@index([workspaceId, sentAt])
  @@map("email_messages")
}

/// A learned address→lead mapping, written when someone links an unmatched
/// thread by hand.
///
/// Without this the unmatched queue is endless manual work: the same person
/// writing from the same address would need linking every time. One correction
/// teaches the matcher permanently.
model AddressLink {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  email       String
  leadId      String?  @map("lead_id")
  companyId   String?  @map("company_id")
  createdBy   String?  @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([workspaceId, email])
  @@index([workspaceId])
  @@map("address_links")
}

/// Someone asked for their audit report, and what exactly they agreed to
/// (P12/1b).
///
/// This is EVIDENCE, not a preference flag. "Did they consent?" is the easy
/// question; the one that actually gets asked is "what wording did they agree
/// to, when, and from where" — so the text version, the timestamp and the full
/// IP are all part of the record. PublicAudit stores a truncated IP prefix
/// because that is abuse control; this stores the whole address because the
/// visitor asked us for something and we may have to show that they did.
model PublicAuditConsent {
  id            String   @id @default(cuid())
  workspaceId   String   @map("workspace_id")
  publicAuditId String   @map("public_audit_id")
  name          String
  email         String
  companyName   String?  @map("company_name")
  /// Always true — a row cannot exist without it, since it is what authorises
  /// the delivery. Stored anyway so the record is self-describing.
  serviceConsent   Boolean @default(true) @map("service_consent")
  /// The lawful basis for any later outreach. Defaults FALSE and is only ever
  /// set by an affirmative tick: a pre-checked box is not consent.
  marketingConsent Boolean @default(false) @map("marketing_consent")
  /// Which wording they saw, e.g. "hu-2026-08-14". Replacing the text later
  /// must not invalidate consent collected under the old one.
  consentTextVersion String @map("consent_text_version")
  /// The language the form was presented in.
  locale        String   @default("hu")
  ip            String?
  userAgent     String?  @map("user_agent")
  /// The lead this became, once created.
  leadId        String?  @map("lead_id")
  /// When the report was actually delivered, for support questions.
  reportSentAt  DateTime? @map("report_sent_at")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([workspaceId, createdAt])
  @@index([publicAuditId])
  @@index([email])
  @@map("public_audit_consents")
}

/// A search term we track a company's position for (P2/7).
///
/// Known terms only — this system does no keyword research and holds no
/// search-volume data, so a keyword exists here because someone typed it.
model TrackedKeyword {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  companyId   String   @map("company_id")
  keyword     String
  /// hu-HU unless told otherwise.
  locale      String   @default("hu-HU")
  /// Local intent, e.g. "Budapest,Hungary".
  location    String?
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  positions KeywordPosition[]

  @@unique([companyId, keyword, locale])
  @@index([workspaceId])
  @@map("tracked_keywords")
}

/// One weekly measurement. `position` null means "not in the first hundred",
/// which is a real answer and must not be stored as a large number.
model KeywordPosition {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  keywordId   String   @map("keyword_id")
  position    Int?
  url         String?
  checkedAt   DateTime @default(now()) @map("checked_at")

  keyword TrackedKeyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([keywordId, checkedAt])
  @@map("keyword_positions")
}

/// Personal token letting the browser extension post captures on a user's
/// behalf. The extension runs on linkedin.com, so it cannot use the app's
/// session cookie — this is the credential instead. Hashed at rest, revocable,
/// and scoped to one user in one workspace.
model CaptureToken {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  workspaceId String    @map("workspace_id")
  /// sha256 of the token. The plaintext is shown once, at creation.
  tokenHash   String    @unique @map("token_hash")
  label       String?
  lastUsedAt  DateTime? @map("last_used_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([workspaceId])
  @@map("capture_tokens")
}

model PublicAudit {
  id          String   @id @default(cuid())
  /// Which workspace receives this inbound. Resolved by getPublicIntakeWorkspace().
  workspaceId String   @map("workspace_id")
  url         String
  /// Registrable host, lower-cased — what dedupe and the client blocklist match on.
  domain      String
  auditId     String?  @map("audit_id")
  /// queued | running | done | error | blocked
  status      String   @default("queued")
  /// Set when the request was refused, e.g. rate_limited, client_domain, bot.
  blockedReason String? @map("blocked_reason")
  /// Truncated to a /24 (IPv4) or /48 (IPv6): enough for rate limiting, not a
  /// precise location. The full address is only stored on a consent record,
  /// where it is evidence the visitor asked for something.
  ipPrefix    String?  @map("ip_prefix")
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  /// The audit this request produced, once the worker has one.
  audit       AuditResult? @relation(fields: [auditId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([domain])
  @@index([status])
  @@map("public_audits")
}

model AuditShare {
  id            String    @id @default(cuid())
  workspaceId   String    @map("workspace_id")
  auditId       String    @map("audit_id")
  leadId        String?   @map("lead_id")
  slug          String    @unique
  firstOpenedAt DateTime? @map("first_opened_at")
  openCount     Int       @default(0) @map("open_count")
  expiresAt     DateTime  @map("expires_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  audit AuditResult @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([auditId])
  @@map("audit_shares")
}

model Template {
  id          String         @id @default(cuid())
  workspaceId String         @map("workspace_id")
  type        TemplateType
  lang        Lang           @default(HU)
  name        String
  body        String         @db.Text
  variables   Json           @default("[]")
  version     Int            @default(1)
  status      TemplateStatus @default(DRAFT)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  documents Document[]

  @@index([workspaceId])
  @@map("templates")
}

model Document {
  id                String         @id @default(cuid())
  workspaceId       String         @map("workspace_id")
  leadId            String?        @map("lead_id")
  templateVersionId String?        @map("template_version_id")
  chainParentId     String?        @map("chain_parent_id")
  type              DocumentType
  /// Human-facing number (Q-2026-014). Denormalised out of `payload` so global
  /// search can match it — JSON fields are not portably searchable across
  /// Postgres and MySQL.
  number            String?
  status            DocumentStatus @default(DRAFT)
  watermark         Boolean        @default(true)
  payload           Json?          @map("payload_json")
  totals            Json?          @map("totals_json")
  pdfUrl            String?        @map("pdf_url")
  acceptSlug        String?        @unique @map("accept_slug")
  finalizedAt       DateTime?      @map("finalized_at")
  finalizedBy       String?        @map("finalized_by")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  lead        Lead?             @relation(fields: [leadId], references: [id], onDelete: SetNull)
  template    Template?         @relation(fields: [templateVersionId], references: [id], onDelete: SetNull)
  chainParent Document?         @relation("DocumentChain", fields: [chainParentId], references: [id], onDelete: SetNull)
  chainChild  Document[]        @relation("DocumentChain")
  emailLogs   EmailLog[]
  acceptances QuoteAcceptance[]
  invoices    Invoice[]

  @@index([workspaceId])
  @@index([leadId])
  @@index([workspaceId, number])
  @@map("documents")
}

model EmailLog {
  id          String      @id @default(cuid())
  workspaceId String      @map("workspace_id")
  leadId      String?     @map("lead_id")
  documentId  String?     @map("document_id")
  to          String
  subject     String
  mailgunId   String?     @map("mailgun_id")
  status      EmailStatus @default(QUEUED)
  at          DateTime    @default(now())

  lead     Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  document Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@map("email_logs")
}

model Call {
  id             String      @id @default(cuid())
  workspaceId    String      @map("workspace_id")
  leadId         String      @map("lead_id")
  outcome        CallOutcome
  note           String?     @db.Text
  duration       Int? // seconds
  callbackAt     DateTime?   @map("callback_at")
  callbackDoneAt DateTime?   @map("callback_done_at")
  byUserId       String?     @map("by_user_id")
  at             DateTime    @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([leadId])
  @@map("calls")
}

model Campaign {
  id             String         @id @default(cuid())
  workspaceId    String         @map("workspace_id")
  frameId        String?        @map("frame_id")
  name           String
  segmentQuery   Json?          @map("segment_query")
  status         CampaignStatus @default(DRAFT)
  complianceNote String?        @map("compliance_note") @db.Text
  dailyCap       Int            @default(20) @map("daily_cap")
  startedAt      DateTime?      @map("started_at")
  createdAt      DateTime       @default(now()) @map("created_at")

  frame      Frame?              @relation(fields: [frameId], references: [id], onDelete: SetNull)
  steps      CampaignStep[]
  recipients CampaignRecipient[]

  @@index([workspaceId])
  @@map("campaigns")
}

model CampaignStep {
  id          String  @id @default(cuid())
  workspaceId String  @map("workspace_id")
  campaignId  String  @map("campaign_id")
  stepNumber  Int     @map("step_number")
  delayDays   Int     @default(0) @map("delay_days")
  subject     String?
  body        String  @db.Text

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([campaignId])
  @@map("campaign_steps")
}

model CampaignRecipient {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  campaignId  String    @map("campaign_id")
  leadId      String?   @map("lead_id")
  email       String
  suppressed  Boolean   @default(false)
  bounced     Boolean   @default(false)
  stepSent    Int       @default(0) @map("step_sent")
  repliedAt   DateTime? @map("replied_at")
  sentAt      DateTime? @map("sent_at")

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([campaignId])
  @@map("campaign_recipients")
}

model Referrer {
  id              String       @id @default(cuid())
  workspaceId     String       @map("workspace_id")
  kind            ReferrerKind
  name            String
  linkedCompanyId String?      @map("linked_company_id")
  createdAt       DateTime     @default(now()) @map("created_at")

  linkedCompany Company? @relation(fields: [linkedCompanyId], references: [id], onDelete: SetNull)
  leads         Lead[]

  @@index([workspaceId])
  @@map("referrers")
}

model RegistryData {
  id            String   @id @default(cuid())
  workspaceId   String   @map("workspace_id")
  companyId     String   @unique @map("company_id")
  taxId         String?  @map("tax_id")
  regNumber     String?  @map("reg_number")
  legalName     String?  @map("legal_name")
  headcountBand String?  @map("headcount_band")
  revenueBand   String?  @map("revenue_band")
  statusFlags   Json     @default("[]") @map("status_flags")
  fetchedAt     DateTime @default(now()) @map("fetched_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("registry_data")
}

model DealOutcome {
  id          String     @id @default(cuid())
  workspaceId String     @map("workspace_id")
  leadId      String     @map("lead_id")
  result      DealResult
  reason      String?
  value       Int? // HUF forints
  competitor  String?
  at          DateTime   @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([leadId])
  @@map("deal_outcomes")
}

// Public per-host scheduling page (spec §4.21). slug is globally unique — the
// public path segment on meet.{domain}/{slug}. meeting_types_json holds
// [{ id, label, durationMin }]; config holds working hours, slot step, buffers,
// notice, horizon, timezone.
model BookingPage {
  id           String   @id @default(cuid())
  workspaceId  String   @map("workspace_id")
  hostUserId   String   @map("host_user_id")
  slug         String   @unique
  title        String?
  meetingTypes Json     @default("[]") @map("meeting_types_json")
  config       Json?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@map("booking_pages")
}

model QuoteAcceptance {
  id             String   @id @default(cuid())
  workspaceId    String   @map("workspace_id")
  documentId     String   @map("document_id")
  acceptedByName String   @map("accepted_by_name")
  company        String?
  ip             String?
  userAgent      String?  @map("user_agent")
  at             DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([documentId])
  @@map("quote_acceptances")
}

model Invoice {
  id          String        @id @default(cuid())
  workspaceId String        @map("workspace_id")
  documentId  String?       @map("document_id")
  szamlazzId  String?       @map("szamlazz_id")
  number      String?
  pdfUrl      String?       @map("pdf_url")
  status      InvoiceStatus @default(PREPARED)
  at          DateTime      @default(now())

  document Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@map("invoices")
}

model Suppression {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  address     String
  reason      String?
  at          DateTime @default(now())

  @@unique([workspaceId, address])
  @@index([workspaceId])
  @@map("suppressions")
}

/// One billable (or quota-consuming) call to an external API (P2 follow-up).
///
/// Claude has its own table and its own enforced daily cap; this is everything
/// else we spend money or quota on, in one place, so "what did this month
/// cost" has a single answer. Free APIs are recorded too — for PageSpeed and
/// CrUX the meaningful number is calls against Google's quota, not dollars.
model ApiUsage {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  /// dataforseo | pagespeed | crux | places
  provider    String
  /// What was asked for, e.g. "serp.organic" or "audit".
  operation   String
  /// HTTP requests this row represents — CrUX may retry a www counterpart.
  calls       Int      @default(1)
  /// USD. Exactly 0 for the free Google APIs, and that is the honest value.
  cost        Decimal  @default(0)
  at          DateTime @default(now())

  @@index([workspaceId, at])
  @@map("api_usage")
}

model ClaudeUsage {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  useCase     String   @map("use_case")
  model       String
  tokensIn    Int      @default(0) @map("tokens_in")
  tokensOut   Int      @default(0) @map("tokens_out")
  cost        Decimal  @default(0) // USD
  at          DateTime @default(now())

  @@index([workspaceId])
  @@map("claude_usage")
}
